# Vercel Sandbox is authenticated automatically when deployed on Vercel.
# For local development, use `vercel link` and `vercel env pull .env.local`.
# Do not commit tokens or API keys.

# AI agent provider. OpenRouter free routing is the default model.
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Optional OpenRouter HTTP-Referer. Keep this server-side.
# SITE_URL=https://kraxxdeceit.kraxxsec.com

# To use OpenAI instead:
# AI_PROVIDER=openai
# AI_MODEL=gpt-6.1-sol
# OPENAI_API_KEY=
