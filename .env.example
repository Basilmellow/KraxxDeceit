# Vercel Sandbox is authenticated automatically when deployed on Vercel.
# For local development, use `vercel link` and `vercel env pull .env.local`.
# Do not commit tokens or API keys.

# AI agent provider. OpenRouter free routing is the default model.
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Optional OpenRouter HTTP-Referer. Keep this server-side.
# SITE_URL=https://kraxxdeceit.kraxxsec.com

# To use OpenAI instead:
# AI_PROVIDER=openai
# AI_MODEL=gpt-6.1-sol
# OPENAI_API_KEY=

# Production (server-side only). Shared admission is required in production.
SITE_URL=https://kraxxdeceit.kraxxsec.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public arbitrary URLs remain disabled until explicitly enabled. Demo stays available.
KRAXX_PUBLIC_INVESTIGATIONS_ENABLED=false

# Private workspace: same-project Supabase URL and publishable/anon key only.
# Never configure a secret/service-role key. Keep test passwords local, out of Vercel.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
